# Copy missing settings to .env. Never overwrite an existing API key.
# Server-side settings
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_AUDIO_MODEL=whisper-large-v3
DATABASE_URL=
AUTH_SECRET=
DEMO_MODE=true
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional: ffmpeg executable; defaults to installed imageio-ffmpeg binary.
FFMPEG_PATH=

# Public frontend settings. Never put secrets into VITE_*.
VITE_DEMO_MODE=true
VITE_API_URL=/api

# Email: Brevo HTTPS API recommended; SMTP is an alternative.
BREVO_API_KEY=
SMTP_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FRONTEND_URL=http://127.0.0.1:5173
# Enable for deployed HTTPS.
COOKIE_SECURE=false
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CONTACT=

# Optional Stripe sandbox only; production charges remain disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Local hackathon entry; keep disabled on any public deployment.
PRESENTATION_ENABLED=false
PRESENTATION_STUDENT_ID=0
PRESENTATION_TEACHER_ID=0
